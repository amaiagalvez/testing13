PHP_VERSION="8.4"
NODE_VERSION="24-bullseye"

USER="$(id -u)"
GROUP="$(id -g)"

# Carpeta base del proyecto: de ella cuelgan packages/, demos/ y dc-data/.
# Se calcula a partir de la ubicacion del script (testing13 -> l13), asi que no
# hay que escribirla a mano en ningun sitio.
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Caches que comparten los contenedores. Se crean en el host como tu usuario
# para que nada se genere como root.
DC_DATA_DIR="$BASE_DIR/dc-data"
COMPOSER_CACHE="$DC_DATA_DIR/composerCache"
NPM_CACHE="$DC_DATA_DIR/npmCache"
